# Copy this file to .env, keep .env mode 0600, and never commit real values.
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
PUBLIC_HOST=
PUBLIC_ORIGIN=
API_BASE_URL=/api/v1
API_PREFIX=api/v1
CORS_ALLOWED_ORIGINS=
CORS_ORIGINS=
REQUEST_BODY_LIMIT=128kb
TRUST_PROXY=1

GCP_PROJECT_ID=
GCP_REGION=
GCP_RUNTIME_SERVICE_ACCOUNT=
GCP_RUNTIME_API_KEY=
GCP_RUNTIME_CREDENTIALS_BASE64=
FIRESTORE_DATABASE_ID=

VERTEX_LOCATION=global
VERTEX_MODEL_ID=
VERTEX_TIMEOUT_MS=12000
VERTEX_MAX_INPUT_CHARS=2000
VERTEX_MAX_OUTPUT_TOKENS=1200
VERTEX_TEMPERATURE=0.2
GOOGLE_GENAI_USE_VERTEXAI=true
PROMPT_TEMPLATE_VERSION=
FORMULA_VERSION=

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_GOOGLE_PROVIDER_ID=google.com
FIREBASE_GOOGLE_CLIENT_ID=

EVALUATOR_EMAIL=
EVALUATOR_PASSWORD=
EVALUATOR_UID=
ENABLE_EVALUATOR_CONTROLS=true
DEMO_RESET_TOKEN=
ANALYTICS_HMAC_SECRET=

RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_STATE_PER_MINUTE=60
RATE_LIMIT_MODEL_PER_MINUTE=6
BIGQUERY_DATASET=
BIGQUERY_EVENTS_TABLE=
OTEL_SERVICE_NAME=suraksha-sutra-api
LOG_LEVEL=info
ARTIFACT_REGISTRY=
