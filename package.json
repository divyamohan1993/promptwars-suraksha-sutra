{
  "name": "surakshasutra",
  "version": "0.1.0",
  "private": true,
  "description": "SurakshaSutra adaptive digital-safety learning system",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22.12.0 <23",
    "pnpm": ">=11.22.0 <12"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "build:api": "pnpm --filter @surakshasutra/api build",
    "build:web": "pnpm --filter @surakshasutra/web build",
    "dev": "pnpm --parallel --recursive --if-present start",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm --recursive --if-present test",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@angular/common": "21.2.21",
    "@angular/compiler": "21.2.21",
    "@angular/core": "21.2.21",
    "@angular/platform-browser": "21.2.21",
    "@angular/router": "21.2.21",
    "@angular/service-worker": "21.2.21",
    "@eslint/js": "9.39.5",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.6",
    "rxjs": "7.8.2",
    "typescript-eslint": "8.67.0",
    "tslib": "2.8.1",
    "zone.js": "0.16.0"
  }
}
